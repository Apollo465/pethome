/** 按关键词命中匹配话题，返回命中最多的一个 */
export function matchTopic(question: string): CareTopic | undefined {
  const content = question.toLowerCase();
  let best: CareTopic | undefined = undefined;
  let bestScore = 0;
  for (let i = 0; i < CARE_TOPICS.length; i++) {
    const topic = CARE_TOPICS[i];
    let score = 0;
    for (let j = 0; j < topic.keywords.length; j++) {
      const word = topic.keywords[j].toLowerCase();
      if (content.indexOf(word) >= 0) {
        score += word.length;
      }
    }
    if (score > bestScore) {
      bestScore = score;
      best = topic;
    }
  }
  return bestScore > 0 ? best : undefined;
}

export function hitAnyKeyword(question: string, keywords: string[]): boolean {
  const content = question.toLowerCase();
  for (let i = 0; i < keywords.length; i++) {
    if (content.indexOf(keywords[i].toLowerCase()) >= 0) {
      return true;
    }
  }
  return false;
}

export function topicById(id: string): CareTopic | undefined {
  for (let i = 0; i < CARE_TOPICS.length; i++) {
    if (CARE_TOPICS[i].id === id) {
      return CARE_TOPICS[i];
    }
  }
  return undefined;
}

/** 首页猜你想问 */
export function suggestedTopics(): CareTopic[] {
  const ids: string[] = ['feeding_amount', 'deworm', 'bath', 'soft_stool', 'litter', 'vaccine'];
  const result: CareTopic[] = [];
  for (let i = 0; i < ids.length; i++) {
    const topic = topicById(ids[i]);
    if (topic !== undefined) {
      result.push(topic);
    }
  }
  return result;
}
